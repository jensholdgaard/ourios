# Cargo build output (added now so it is never committed by accident)
/target

# mdBook build output
/book

# Per CLAUDE.md §8.3 — intermediate results, benchmark output,
# query plans, Parquet footers etc. live here and must not be committed.
/scratch

# macOS cruft
.DS_Store

# Editor leftovers
*.rs.bk
*.swp
*~

.env

# Per-tool agent context stays local; AGENTS.md is the only tracked one
# (RFC 0057). A local CLAUDE.md should import it with `@AGENTS.md`.
/CLAUDE.md
/CLAUDE.local.md
/GEMINI.md
/.gemini/

# Per-tool agent state (Claude Code settings, locks, skill links created by
# .agents/setup.sh) is local; nothing under .claude/ is tracked.
/.claude/

# Cargo.lock is NOT ignored — Ourios is a binary (CLAUDE.md §1) and its
# lockfile is part of the reproducible-build contract.
.playwright-mcp/
