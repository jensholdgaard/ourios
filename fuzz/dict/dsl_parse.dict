# libFuzzer dictionary for the dsl_parse target: the RFC 0002 §7 grammar's
# keywords and operators (pipe text) and the structured-JSON surface's tags
# (crates/ourios-querier/src/dsl/structured_query.schema.json), so mutations
# reach the parsers' productions instead of the lexer's error arm. Format: one
# quoted token per line (https://llvm.org/docs/LibFuzzer.html#dictionaries).
# Pass with -dict=.

# predicate
"true"
"false"
"null"
"not "
" and "
" or "
"!"
"&&"
"||"
"("
")"
"=="
"!="
"<"
"<="
">"
">="
"=~"
"!~"

# fields and paths
"body"
"ts"
"observed_ts"
"trace_id"
"span_id"
"scope"
"event_name"
"flags"
"service"
"template_id"
"confidence"
"lossy"
"severity"
"attr."
"resource."
"attr[\""
"resource[\""
"\"]"

# calls
"matches("
"contains("
"starts_with("
"ends_with("
"resolves_to("

# severity names
"trace"
"debug"
"info"
"warn"
"error"
"fatal"

# stages
" | "
"range("
"count"
" by "
"sum("
"min("
"max("
"avg("
"sort "
" asc"
" desc"
"limit "
"project "
"render"
"param("
"bucket("

# literals and time
"now"
"-1h"
"5m"
"30s"
"1d"
"2w"
"2026-01-02T03:04:05Z"
"2026-01-02T03:04:05.123456789+01:00"
"1.0"
"0.7"
"\""
"\\\""
"\\\\"
"\\n"
"\\u0041"

# drift (RFC 0010)
"drift from "
" to "

# structured JSON surface
"{\"predicate\":"
"\"stages\":["
"\"field\":"
"\"op\":"
"\"value\":"
"\"call\":"
"\"args\":"
"\"const\":"
"\"not\":"
"\"and\":["
"\"or\":["
"\"range\":"
"\"from\":"
"\"to\":"
"\"count\":"
"\"by\":["
"\"sort\":"
"\"key\":"
"\"desc\":"
"\"limit\":"
"\"project\":["
"\"render\":"
"\"param\":"
"\"bucket\":"
"\"drift\":"
"\"attr\":"
"\"resource\":"

# the promoted keys the planning oracle's scan schema declares (RFC0015.15),
# one per RFC 0042 class, so ordering, regex and grouping on attributes lower
"deployment.environment"
"user.id"
"http.response.status_code"
"duration"
"attr.user.id"
"attr.duration"
"attr.http.response.status_code"
"resource.deployment.environment"
